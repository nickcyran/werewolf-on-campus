[node name="Bullets" type="RichTextLabel" parent="Slides/Welcome/Scroll/Margin/VBox/BulletIndent"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"IntroBullets"
bbcode_enabled = true
text = "[ul bullet=●]First, yes—werewolves are real. And unfortunately, they are a verified threat. They can shapeshift into wolves, eat humans, and they have been known to spread false information to make their next meal a little easier to find. Luckily, not everything you hear comes from a werewolf.
Humans can be helpful too! Some people at Tri-Fang are experts who provide real, useful, evidence-based information. Others are scared, confused, or simply don't know what they're talking about—and may accidentally spread misinformation.
You may even encounter people who are skeptical of evidence, even when the facts are right in front of them. That's where [u]you[/u] come in.
Your job is to figure out which information you can trust and which information you should question.
You don't need to know anything about werewolves before playing. Everything you need to succeed is right here at Tri-Fang University.[/ul]"
fit_content = true
scroll_active = false

[node name="ClosingSpacer" type="Control" parent="Slides/Welcome/Scroll/Margin/VBox"]
custom_minimum_size = Vector2(0, 57)
layout_mode = 2
mouse_filter = 2

[node name="Closing" type="Label" parent="Slides/Welcome/Scroll/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"IntroClosing"
text = "The world may be fictional, but the skills you're practicing are real. Think carefully. Check your sources. And whatever you do...
Don't become a werewolf's dinner!!!"
