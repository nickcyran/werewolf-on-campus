theme_override_constants/line_separation = 6
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "Student social media reported werewolf activity on the Tri-Fang University campus last week. Further investigation confirmed the accuracy of the information: there is a werewolf on university grounds."
fit_content = true
