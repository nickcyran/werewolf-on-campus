[ext_resource type="Texture2D" uid="uid://bhu5ydgid8xbe" path="res://assets/media/MidStateEnd-Pup 1.png" id="6_pup_mid"]
[ext_resource type="Texture2D" uid="uid://dtshnvqvytvyi" path="res://assets/media/FailStateEnd-Pup 1.png" id="7_pup_fail"]

[sub_resource type="Resource" id="Resource_tier_win"]
script = ExtResource("3_tier")
min_ratio = 0.71
pup = ExtResource("5_pup_win")
message = "Solid reading. You separated what the sources backed up from what they didn't."
verdict_style = &"GameEndScoreWin"
backdrop_style = &"GameEndPupDiscWin"
bob_height = 8.0

[sub_resource type="Resource" id="Resource_tier_mid"]
script = ExtResource("3_tier")
min_ratio = 0.4
pup = ExtResource("6_pup_mid")
message = "About half. The tricky ones are usually the claims with no evidence attached."
verdict_style = &"GameEndScoreMid"
backdrop_style = &"GameEndPupDiscMid"
bob_height = 4.0

[sub_resource type="Resource" id="Resource_tier_fail"]
script = ExtResource("3_tier")
pup = ExtResource("7_pup_fail")
message = "A lot of these slipped past. Worth going back to see what the sources actually supported."
verdict_style = &"GameEndScoreFail"
backdrop_style = &"GameEndPupDiscFail"

