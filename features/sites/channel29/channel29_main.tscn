theme_override_constants/line_separation = 6
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "[url=professor][color=#7a1f1f][u]Dr. Clemence Housman[/u][/color][/url], Professor of Cryptids and Lycanthropy at the university, suggests that everyone carry something made of pure silver. Even in human form, werewolves are allergic to the metal and will immediately break out into a distinctive rash if they touch it. This is the most certain way to identify and repel a werewolf."
fit_content = true
scroll_active = false
meta_underlined = true
