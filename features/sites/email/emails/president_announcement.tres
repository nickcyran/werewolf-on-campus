[resource]
script = ExtResource("1_data")
sender = "dbenso@tri-fang.edu"
subject = "Breaking News: Campus Werewolf Apprehended"
body = "Dear campus community,

The campus werewolf has been identified and taken into custody, says university president Dr. Derek Hale. There is no need for students to worry. All is safe, and classes will resume as normal. Thank you for your cooperation during this time!"
